{
  "name": "portal-hub-construtec",
  "version": "1.0.0",
  "description": "Portal Hub Centralizador da Suíte Construtec (Orçamentos, Centro de Custos e Chamados)",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "validate": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/validate-suite.ps1",
    "electron": "electron .",
    "build:portable": "electron-builder --win portable --publish never"
  },
  "keywords": [
    "construtec",
    "hub",
    "portal",
    "launcher"
  ],
  "author": "Construtec Engenharia",
  "license": "UNLICENSED",
  "dependencies": {},
  "devDependencies": {
    "electron": "41.10.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.construtec.portal-hub",
    "productName": "Portal Hub Construtec",
    "electronVersion": "41.10.7",
    "directories": { "output": "dist" },
    "files": ["server.js", "public/**/*", "desktop/**/*", "lib/**/*", "package.json"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "public/assets/construtec-favicon.ico"
    },
    "portable": { "artifactName": "Portal-Hub-Construtec-${version}-Portable.${ext}" }
  }
}
